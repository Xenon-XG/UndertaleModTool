<local:DataUserControl x:Class="UndertaleModTool.UndertaleRoomEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UndertaleModTool"
             xmlns:undertale="clr-namespace:UndertaleModLib.Models;assembly=UndertaleModLib"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" d:DataContext="{d:DesignInstance undertale:UndertaleRoom}" x:Name="RoomEditor">
    <UserControl.Resources>
        <ResourceDictionary>
            <local:GridConverter x:Key="GridConverter"/>
            <local:UndertaleCachedImageLoader x:Key="UndertaleCachedImageLoader"/>
            <local:ColorConverter x:Key="ColorConverter"/>
            <local:SimplePointsDisplayConverter x:Key="SimplePointsDisplayConverter"/>
            <local:LayerItemsSourceConverter x:Key="LayerItemsSourceConverter"/>
            <local:LayerZIndexConverter x:Key="LayerZIndexConverter"/>
            <local:IsGMS2Converter x:Key="IsGMS2Converter" />
            <local:BGColorConverter x:Key="BGColorConverter"/>
            <local:BGViewportConverter x:Key="BGViewportConverter"/>
            <local:LayerTypeConverter x:Key="LayerTypeConverter"/>
            <local:GridSizeGroupConverter x:Key="GridSizeGroupConverter"/>
            <local:GridColumnSizeConverter x:Key="GridColumnSizeConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
            <local:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
            <local:ColorToOpacityConverter x:Key="ColorToOpacityConverter"/>
            <local:CachedTileImageLoader x:Key="CachedTileImageLoader"/>
            <local:CachedTileDataLoader x:Key="CachedTileDataLoader"/>
            <local:TileLayerTemplateSelector x:Key="TileLayerTemplateSelector"/>
            <local:TileRectanglesConverter x:Key="TileRectanglesConverter"/>
            <local:CachedImageLoaderWithIndex x:Key="CachedImageLoaderWithIndex"/>
            <local:IsVersionAtLeastConverter x:Key="IsVersionAtLeastConverter"/>
            <local:NegateNumberConverter x:Key="NegateNumberConverter"/>
            <local:ParentGridHeightConverter x:Key="ParentGridHeightConverter"/>
            <local:ParticleSystemRectConverter x:Key="ParticleSystemRectConverter"/>
            <local:GameObjectToStringConverter x:Key="GameObjectToStringConverter"/>
            <CompositeCollection x:Key="AllObjectsGMS1">
                <CollectionContainer Collection="{Binding Source={x:Reference RoomEditor}, Path=DataContext.Backgrounds}"/>
                <CollectionContainer Collection="{Binding Source={x:Reference RoomEditor}, Path=DataContext.Tiles}"/>
                <CollectionContainer Collection="{Binding Source={x:Reference RoomEditor}, Path=DataContext.GameObjects}"/>
                <CollectionContainer Collection="{Binding Source={x:Reference RoomEditor}, Path=PreviewPath, Converter={StaticResource SimplePointsDisplayConverter}}"/>
            </CompositeCollection>
            <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type sys:Enum}" x:Key="AnimationSpeedType">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="undertale:AnimationSpeedType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <Style x:Key="Centered" TargetType="FrameworkElement">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controls/TransparencyGridBrush.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.CommandBindings>
        <CommandBinding Command="Copy" Executed="Command_Copy" />
        <CommandBinding Command="Paste" Executed="Command_Paste" />
        <CommandBinding Command="{x:Static local:UndertaleRoomEditor.PasteShiftCommand}" Executed="Command_PasteShift" />
        <CommandBinding Command="Undo" Executed="Command_Undo" />
    </UserControl.CommandBindings>
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="C" Command="Copy"/>
        <KeyBinding Modifiers="Control" Key="P" Command="Paste"/>
        <KeyBinding Modifiers="Control+Shift" Key="V" Command="{x:Static local:UndertaleRoomEditor.PasteShiftCommand}"/>
        <KeyBinding Modifiers="Control" Key="Z" Command="Undo"/>
    </UserControl.InputBindings>

    <Grid Height="{Binding RelativeSource={RelativeSource FindAncestor,
                           AncestorType={x:Type ScrollViewer}},
                           Path=ActualHeight,
                           Converter={StaticResource ParentGridHeightConverter}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="342px"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Column="0" Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TreeView Grid.Column="0" Margin="0,0,3,0" SelectedItemChanged="TreeView_SelectedItemChanged" Name="RoomObjectsTree"
                      KeyDown="RoomObjectsTree_KeyDown" MouseDoubleClick="RoomObjectsTree_MouseDoubleClick" MouseDown="RoomObjectsTree_MouseDown">
                <TreeView.Resources>
                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+GameObject}">
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Mode="OneWay" Converter="{StaticResource GameObjectToStringConverter}">
                                    <Binding Path="." Mode="OneWay"/>
                                    <Binding Path="InstanceID" Mode="OneWay"/>
                                    <Binding Path="ObjectDefinition.Name.Content" Mode="OneWay" TargetNullValue="?" FallbackValue="空实例"/>
                                </MultiBinding>
                            </TextBlock.Text>
                            <TextBlock.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Centered}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Nonexistent, Mode=OneWay}" Value="True">
                                            <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Resources>
                            <TextBlock.ContextMenu>
                                <local:ContextMenuDark>
                                    <MenuItem Header="复制对象" Click="MenuItem_Copy_Click" InputGestureText="Ctrl+C"/>
                                    <MenuItem Header="删除对象" Click="MenuItem_Delete_Click" InputGestureText="Delete"/>
                                </local:ContextMenuDark>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Tile}">
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Mode="OneWay" StringFormat="{}图块 {0}（{1}）">
                                    <Binding Path="InstanceID" Mode="OneWay"/>
                                    <Binding Path="ObjectDefinition.Name.Content" Mode="OneWay" TargetNullValue="?" FallbackValue="空图块"/>
                                </MultiBinding>
                            </TextBlock.Text>
                            <TextBlock.ContextMenu>
                                <local:ContextMenuDark>
                                    <MenuItem Header="复制图块" Click="MenuItem_Copy_Click" InputGestureText="Ctrl+C"/>
                                    <MenuItem Header="删除图块" Click="MenuItem_Delete_Click" InputGestureText="Delete"/>
                                </local:ContextMenuDark>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+SpriteInstance}">
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Mode="OneWay" StringFormat="{}精灵 {0}（{1}）">
                                    <Binding Path="Name.Content" Mode="OneWay" TargetNullValue="?" FallbackValue="空名称"/>
                                    <Binding Path="Sprite.Name.Content" Mode="OneWay" TargetNullValue="?" FallbackValue="空精灵"/>
                                </MultiBinding>
                            </TextBlock.Text>
                            <TextBlock.ContextMenu>
                                <local:ContextMenuDark>
                                    <MenuItem Header="复制精灵实例" Click="MenuItem_Copy_Click" InputGestureText="Ctrl+C"/>
                                    <MenuItem Header="删除精灵实例" Click="MenuItem_Delete_Click" InputGestureText="Delete"/>
                                </local:ContextMenuDark>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+ParticleSystemInstance}">
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Mode="OneWay" StringFormat="{}粒子系统 {0}（{1}）">
                                    <Binding Path="Name.Content" Mode="OneWay" TargetNullValue="?" FallbackValue="空名称"/>
                                    <Binding Path="ParticleSystem.Name.Content" Mode="OneWay" TargetNullValue="?" FallbackValue="空粒子系统"/>
                                </MultiBinding>
                            </TextBlock.Text>
                            <TextBlock.ContextMenu>
                                <local:ContextMenuDark>
                                    <MenuItem Header="复制粒子系统实例" Click="MenuItem_Copy_Click" InputGestureText="Ctrl+C"/>
                                    <MenuItem Header="删除粒子系统实例" Click="MenuItem_Delete_Click" InputGestureText="Delete"/>
                                </local:ContextMenuDark>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </DataTemplate>
                </TreeView.Resources>

                <TreeViewItem Header="{Binding Name.Content}" Name="RoomRootItem" IsExpanded="True">
                    <TreeViewItem Name="BGItems" Header="背景" ItemsSource="{Binding Backgrounds, Mode=OneWay}" Visibility="{Binding Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}" IsExpanded="True">
                        <TreeViewItem.Resources>
                            <local:ContextMenuDark x:Key="bgContextMenu">
                                <MenuItem Header="删除背景" Click="MenuItem_Delete_Click" InputGestureText="Delete"/>
                            </local:ContextMenuDark>
                        </TreeViewItem.Resources>
                        <TreeViewItem.ItemTemplate>
                            <HierarchicalDataTemplate>
                                <TextBlock Text="{Binding BackgroundDefinition, Mode=OneWay, TargetNullValue='（无名称）'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ContextMenu" Value="{StaticResource bgContextMenu}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Enabled, Mode=OneWay}" Value="False">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                                    <Setter Property="ContextMenu" Value="{x:Null}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </HierarchicalDataTemplate>
                        </TreeViewItem.ItemTemplate>
                    </TreeViewItem>
                    <TreeViewItem Name="ViewItems" Header="视图" ItemsSource="{Binding Views, Mode=OneWay}" IsExpanded="True">
                        <TreeViewItem.Resources>
                            <local:ContextMenuDark x:Key="viewContextMenu">
                                <MenuItem Header="禁用视图" Click="MenuItem_Delete_Click" InputGestureText="Delete"/>
                            </local:ContextMenuDark>
                        </TreeViewItem.Resources>
                        <TreeViewItem.ItemTemplate>
                            <HierarchicalDataTemplate>
                                <TextBlock Text="视图">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ContextMenu" Value="{StaticResource viewContextMenu}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Enabled, Mode=OneWay}" Value="False">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                                    <Setter Property="ContextMenu" Value="{x:Null}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </HierarchicalDataTemplate>
                        </TreeViewItem.ItemTemplate>
                    </TreeViewItem>
                    <!-- GameObjItems header changes depending on GMS version -->
                    <TreeViewItem Name="GameObjItems" Header="游戏对象" ItemsSource="{Binding GameObjects, Mode=OneWay}">
                        <TreeViewItem.Resources>
                            <local:ContextMenuDark x:Key="cm">
                                <MenuItem Header="新建对象实例" Click="MenuItem_NewObjectInstance_Click"/>
                                <MenuItem Header="粘贴对象实例" Click="MenuItem_Paste_Click" InputGestureText="Ctrl+V"/>
                            </local:ContextMenuDark>
                        </TreeViewItem.Resources>
                        <TreeViewItem.Style>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="ContextMenu" Value="{StaticResource cm}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}" Value="False">
                                        <DataTrigger.Setters>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                            <Setter Property="ContextMenu" Value="{x:Null}"/>
                                        </DataTrigger.Setters>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeViewItem.Style>
                    </TreeViewItem>
                    <TreeViewItem Name="TileItems" Header="图块" ItemsSource="{Binding Tiles, Mode=OneWay}" Visibility="{Binding Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}">
                        <TreeViewItem.ItemTemplate>
                            <HierarchicalDataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Mode="OneWay" StringFormat="{}图块 {0}（{1}）(UndertaleRoom+Tile)">
                                            <Binding Path="InstanceID"/>
                                            <Binding Path="ObjectDefinition.Name.Content" TargetNullValue="?" FallbackValue="空图块"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                    <TextBlock.ContextMenu>
                                        <local:ContextMenuDark>
                                            <MenuItem Header="删除图块" Click="MenuItem_Delete_Click" InputGestureText="Delete"/>
                                            <MenuItem Header="复制图块" Click="MenuItem_Copy_Click" InputGestureText="Ctrl+V"/>
                                        </local:ContextMenuDark>
                                    </TextBlock.ContextMenu>
                                </TextBlock>
                            </HierarchicalDataTemplate>
                        </TreeViewItem.ItemTemplate>
                        <TreeViewItem.ContextMenu>
                            <local:ContextMenuDark>
                                <MenuItem Header="新建图块" Click="MenuItem_NewGMS1Tile_Click"/>
                                <MenuItem Header="粘贴图块" Click="MenuItem_Paste_Click" InputGestureText="Ctrl+V"/>
                            </local:ContextMenuDark>
                        </TreeViewItem.ContextMenu>
                    </TreeViewItem>
                    <TreeViewItem Name="LayerItems" Header="图层" ItemsSource="{Binding Layers, Mode=OneWay}" IsExpanded="True" Visibility="{Binding Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}, ConverterParameter=invert}">
                        <TreeViewItem.ContextMenu>
                            <local:ContextMenuDark>
                                <MenuItem Header="新建实例图层" Click="MenuItem_NewLayerInstances_Click"/>
                                <MenuItem Header="新建图块图层" Click="MenuItem_NewLayerTiles_Click"/>
                                <MenuItem Header="新建背景图层" Click="MenuItem_NewLayerBackground_Click"/>
                                <MenuItem Header="新建资源图层" Click="MenuItem_NewLayerAssets_Click"/>
                            </local:ContextMenuDark>
                        </TreeViewItem.ContextMenu>
                        <TreeViewItem.Resources>
                            <Style x:Key="LayerItemStyle" TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible, Mode=OneWay}" Value="False">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeViewItem.Resources>
                        <TreeViewItem.ItemTemplateSelector>
                            <local:LayerDataTemplateSelector>
                                <local:LayerDataTemplateSelector.PathDataTemplate>
                                    <HierarchicalDataTemplate ItemTemplateSelector="{x:Null}">
                                        <TextBlock Text="{Binding LayerName.Content, Mode=OneWay}" Style="{StaticResource LayerItemStyle}"/>
                                    </HierarchicalDataTemplate>
                                </local:LayerDataTemplateSelector.PathDataTemplate>
                                <local:LayerDataTemplateSelector.InstancesDataTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding InstancesData.Instances, Mode=OneWay}" ItemTemplateSelector="{x:Null}">
                                        <TextBlock Text="{Binding LayerName.Content, Mode=OneWay}" Style="{StaticResource LayerItemStyle}">
                                            <TextBlock.ContextMenu>
                                                <local:ContextMenuDark>
                                                    <MenuItem Header="新建对象实例" Click="MenuItem_NewGMS2ObjectInstance_Click"/>
                                                    <MenuItem Header="粘贴对象实例" Click="MenuItem_Paste_Click" InputGestureText="Ctrl+V"/>
                                                    <MenuItem Header="删除图层" Click="MenuItem_Delete_Click" InputGestureText="Delete"/>
                                                </local:ContextMenuDark>
                                            </TextBlock.ContextMenu>
                                        </TextBlock>
                                    </HierarchicalDataTemplate>
                                </local:LayerDataTemplateSelector.InstancesDataTemplate>
                                <local:LayerDataTemplateSelector.TilesDataTemplate>
                                    <HierarchicalDataTemplate ItemTemplateSelector="{x:Null}">
                                        <TextBlock Text="{Binding LayerName.Content, Mode=OneWay}" Style="{StaticResource LayerItemStyle}">
                                            <TextBlock.ContextMenu>
                                                <local:ContextMenuDark>
                                                    <MenuItem Header="删除图层" Click="MenuItem_Delete_Click" InputGestureText="Delete"/>
                                                </local:ContextMenuDark>
                                            </TextBlock.ContextMenu>
                                        </TextBlock>
                                    </HierarchicalDataTemplate>
                                </local:LayerDataTemplateSelector.TilesDataTemplate>
                                <local:LayerDataTemplateSelector.AssetsDataTemplate>
                                    <HierarchicalDataTemplate ItemTemplateSelector="{x:Null}">
                                        <HierarchicalDataTemplate.ItemsSource>
                                            <MultiBinding Mode="OneWay">
                                                <MultiBinding.Converter>
                                                    <local:MultiCollectionBinding/>
                                                    <!-- TODO: hack, may break updates -->
                                                </MultiBinding.Converter>
                                                <Binding Path="AssetsData.LegacyTiles"/>
                                                <Binding Path="AssetsData.Sprites"/>
                                                <Binding Path="AssetsData.Sequences"/>
                                                <Binding Path="AssetsData.NineSlices"/>
                                                <Binding Path="AssetsData.ParticleSystems"/>
                                            </MultiBinding>
                                        </HierarchicalDataTemplate.ItemsSource>
                                        <TextBlock Text="{Binding LayerName.Content, Mode=OneWay}" Style="{StaticResource LayerItemStyle}">
                                            <TextBlock.ContextMenu>
                                                <local:ContextMenuDark>
                                                    <MenuItem Header="新建旧式图块" Click="MenuItem_NewLegacyTile_Click"/>
                                                    <MenuItem Header="新建精灵实例" Click="MenuItem_NewSprite_Click"/>
                                                    <MenuItem Header="粘贴资源" Click="MenuItem_Paste_Click" InputGestureText="Ctrl+V"/>
                                                    <MenuItem Header="删除图层" Click="MenuItem_Delete_Click" InputGestureText="Delete"/>
                                                </local:ContextMenuDark>
                                            </TextBlock.ContextMenu>
                                        </TextBlock>
                                    </HierarchicalDataTemplate>
                                </local:LayerDataTemplateSelector.AssetsDataTemplate>
                                <local:LayerDataTemplateSelector.BackgroundDataTemplate>
                                    <HierarchicalDataTemplate ItemTemplateSelector="{x:Null}">
                                        <TextBlock Text="{Binding LayerName.Content, Mode=OneWay}" Style="{StaticResource LayerItemStyle}">
                                            <TextBlock.ContextMenu>
                                                <local:ContextMenuDark>
                                                    <MenuItem Header="删除图层" Click="MenuItem_Delete_Click" InputGestureText="Delete"/>
                                                </local:ContextMenuDark>
                                            </TextBlock.ContextMenu>
                                        </TextBlock>
                                    </HierarchicalDataTemplate>
                                </local:LayerDataTemplateSelector.BackgroundDataTemplate>
                                <local:LayerDataTemplateSelector.EffectDataTemplate>
                                    <HierarchicalDataTemplate ItemTemplateSelector="{x:Null}">
                                        <TextBlock Text="{Binding LayerName.Content, Mode=OneWay}" Style="{StaticResource LayerItemStyle}">
                                            <TextBlock.ContextMenu>
                                                <local:ContextMenuDark>
                                                    <MenuItem Header="删除图层" Click="MenuItem_Delete_Click" InputGestureText="Delete"/>
                                                </local:ContextMenuDark>
                                            </TextBlock.ContextMenu>
                                        </TextBlock>
                                    </HierarchicalDataTemplate>
                                </local:LayerDataTemplateSelector.EffectDataTemplate>
                            </local:LayerDataTemplateSelector>
                        </TreeViewItem.ItemTemplateSelector>
                    </TreeViewItem>
                </TreeViewItem>
            </TreeView>

            <Border Grid.Column="1" BorderBrush="#828790" BorderThickness="0,1,1,1"
                    Height="Auto" VerticalAlignment="Top" Margin="-3,0,0,0">
                <StackPanel Name="MoveButtonsPanel" Margin="1,1,1,1">
                    <local:RepeatButtonDark FontFamily="Marlett" FontSize="14" Content="5" Margin="0,0,0,2"
                                            ToolTip="上移项目 (-)" ToolTipService.InitialShowDelay="250"
                                            Click="TreeViewMoveUpButton_Click"/>
                    <local:RepeatButtonDark FontFamily="Marlett" FontSize="14" Content="6"
                                            ToolTip="下移项目 (+)" ToolTipService.InitialShowDelay="250"
                                            Click="TreeViewMoveDownButton_Click"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="2" Margin="3,0,0,0" Name="ObjectEditor" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom}">
                        <Grid IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <!-- "s22" = size 22 - default height of text box -->
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="{Binding Flags, Mode=OneTime, Converter={StaticResource GridSizeGroupConverter}}"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="{Binding Flags, Mode=OneTime, Converter={StaticResource GridSizeGroupConverter}}"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="TextBox" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="local:UndertaleStringReference" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="local:UndertaleObjectReference" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="local:ColorPicker" BasedOn="{StaticResource Centered}"/>
                            </Grid.Resources>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3">名称</TextBlock>
                            <local:UndertaleStringReference Grid.Row="0" Grid.Column="2" Margin="3" ObjectReference="{Binding Name}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3">标题</TextBlock>
                            <local:UndertaleStringReference Grid.Row="1" Grid.Column="2" Margin="3" ObjectReference="{Binding Caption}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="3">尺寸</TextBlock>
                            <Grid Grid.Row="2" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:TextBoxDark Grid.Column="0" Margin="3" Text="{Binding Width}"/>
                                <local:TextBoxDark Grid.Column="1" Margin="3" Text="{Binding Height}"/>
                            </Grid>

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="3">速度</TextBlock>
                            <local:TextBoxDark Grid.Row="3" Grid.Column="2" Margin="3" Text="{Binding Speed}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="3">持久</TextBlock>
                            <CheckBox Grid.Row="4" Grid.Column="2" Margin="3" IsChecked="{Binding Persistent}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="3" Visibility="{Binding Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}">背景颜色</TextBlock>
                            <local:ColorPicker HasAlpha="False" Grid.Row="5" Grid.Column="2" Margin="3" Color="{Binding BackgroundColor}" Visibility="{Binding Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Margin="3" Visibility="{Binding Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}">绘制背景颜色</TextBlock>
                            <CheckBox Grid.Row="6" Grid.Column="2" Margin="3" IsChecked="{Binding DrawBackgroundColor}" Visibility="{Binding Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Margin="3">创建代码</TextBlock>
                            <local:UndertaleObjectReference Grid.Row="7" Grid.Column="2" Margin="3" ObjectReference="{Binding CreationCodeId}" ObjectType="{x:Type undertale:UndertaleCode}"
                                                            Room="{Binding}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Margin="3">标志</TextBlock>
                            <local:FlagsBox Grid.Row="8" Grid.Column="2" Margin="3" Value="{Binding Flags, Converter={StaticResource IsGMS2Converter}, ConverterParameter=flags}"/>

                            <TextBlock Grid.Row="9" Grid.Column="0" Margin="3">物理世界</TextBlock>
                            <local:TextBoxDark Grid.Row="9" Grid.Column="2" Margin="3" Text="{Binding World}"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Margin="3">上/左/右/下</TextBlock>
                            <Grid Grid.Row="10" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:TextBoxDark Grid.Column="0" Margin="3" Text="{Binding Top}"/>
                                <local:TextBoxDark Grid.Column="1" Margin="3" Text="{Binding Left}"/>
                                <local:TextBoxDark Grid.Column="2" Margin="3" Text="{Binding Right}"/>
                                <local:TextBoxDark Grid.Column="3" Margin="3" Text="{Binding Bottom}"/>
                            </Grid>

                            <TextBlock Grid.Row="11" Grid.Column="0" Margin="3">重力</TextBlock>
