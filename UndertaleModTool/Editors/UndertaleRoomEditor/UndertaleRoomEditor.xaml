                                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Layer+LayerAssetsData}">
                                        <TextBlock Margin="3" Text="包含旧式图块与精灵，已列于左侧树中"/>
                                    </DataTemplate>
                                </ContentControl.Resources>
                            </ContentControl>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+SpriteInstance}">
                        <Grid IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="TextBox" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="local:UndertaleStringReference" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="local:UndertaleObjectReference" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="local:ColorPicker" BasedOn="{StaticResource Centered}"/>
                            </Grid.Resources>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3">名称</TextBlock>
                            <local:UndertaleStringReference Grid.Row="0" Grid.Column="2" Margin="3" ObjectReference="{Binding Name}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3">定义</TextBlock>
                            <local:UndertaleObjectReference Grid.Row="1" Grid.Column="2" Margin="3" ObjectReference="{Binding Sprite}" ObjectType="{x:Type undertale:UndertaleSprite}" CanRemove="False"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="3">位置</TextBlock>
                            <Grid Grid.Row="2" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:TextBoxDark Grid.Column="0" Margin="3" Text="{Binding X}" ToolTip="X"/>
                                <local:TextBoxDark Grid.Column="1" Margin="3" Text="{Binding Y}" ToolTip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="3">缩放</TextBlock>
                            <Grid Grid.Row="3" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:TextBoxDark Grid.Column="0" Margin="3" Text="{Binding ScaleX}" ToolTip="X"/>
                                <local:TextBoxDark Grid.Column="1" Margin="3" Text="{Binding ScaleY}" ToolTip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="3">颜色</TextBlock>
                            <local:ColorPicker Grid.Row="4" Grid.Column="2" Margin="3" Color="{Binding Color}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="3">动画速度</TextBlock>
                            <Grid Grid.Row="5" Grid.Column="2" Margin="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <local:TextBoxDark Grid.Column="0" Text="{Binding AnimationSpeed}"/>
                                <local:ComboBoxDark Grid.Column="1" ItemsSource="{Binding Source={StaticResource AnimationSpeedType}}" SelectedItem="{Binding AnimationSpeedType}" />
                            </Grid>

                            <TextBlock Grid.Row="6" Grid.Column="0" Margin="3">帧索引</TextBlock>
                            <local:TextBoxDark Grid.Row="6" Grid.Column="2" Margin="3" Text="{Binding FrameIndex}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Margin="3">旋转</TextBlock>
                            <local:TextBoxDark Grid.Row="7" Grid.Column="2" Margin="3" Text="{Binding Rotation}"/>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+ParticleSystemInstance}">
                        <Grid IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="TextBox" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="local:UndertaleStringReference" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="local:UndertaleObjectReference" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="local:ColorPicker" BasedOn="{StaticResource Centered}"/>
                            </Grid.Resources>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3">名称</TextBlock>
                            <local:UndertaleStringReference Grid.Row="0" Grid.Column="2" Margin="3" ObjectReference="{Binding Name}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3">定义</TextBlock>
                            <local:UndertaleObjectReference Grid.Row="1" Grid.Column="2" Margin="3" ObjectReference="{Binding ParticleSystem}" ObjectType="{x:Type undertale:UndertaleParticleSystem}" CanRemove="False"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="3">位置</TextBlock>
                            <Grid Grid.Row="2" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:TextBoxDark Grid.Column="0" Margin="3" Text="{Binding X}" ToolTip="X"/>
                                <local:TextBoxDark Grid.Column="1" Margin="3" Text="{Binding Y}" ToolTip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="3">缩放</TextBlock>
                            <Grid Grid.Row="3" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:TextBoxDark Grid.Column="0" Margin="3" Text="{Binding ScaleX}" ToolTip="X"/>
                                <local:TextBoxDark Grid.Column="1" Margin="3" Text="{Binding ScaleY}" ToolTip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="3">颜色</TextBlock>
                            <local:ColorPicker Grid.Row="4" Grid.Column="2" Margin="3" Color="{Binding Color}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="3">旋转</TextBlock>
                            <local:TextBoxDark Grid.Row="5" Grid.Column="2" Margin="3" Text="{Binding Rotation}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Margin="3" Text="实例 ID"
                                       Visibility="{Binding Mode=OneTime, Converter={StaticResource IsVersionAtLeastConverter},ConverterParameter=2024.14}"/>
                            <local:TextBoxDark Grid.Row="6" Grid.Column="2" Margin="3" Text="{Binding InstanceID}"
                                               Visibility="{Binding Mode=OneTime, Converter={StaticResource IsVersionAtLeastConverter},ConverterParameter=2024.14}"/>
                        </Grid>
                    </DataTemplate>
                </ContentControl.Resources>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Column="0" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" ShowsPreview="True" Width="Auto" Height="3"/>

        <!-- Don't forget to modify "UndertaleRoomRenderer" control as well -->
        <ScrollViewer Name="RoomGraphicsScroll" Margin="0,8,0,0" Grid.Column="0" Grid.Row="2" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" ScrollChanged="ScrollViewer_ScrollChanged" MouseUp="RoomGraphicsScroll_MouseUp" MouseDown="RoomGraphicsScroll_MouseDown" MouseMove="RoomGraphicsScroll_MouseMove" MouseLeave="RoomGraphicsScroll_MouseLeave">
            <ItemsControl Name="RoomGraphics" Background="Gray" MouseDown="RectangleBackground_MouseDown" MouseMove="RectangleBackground_MouseMove" MouseUp="RectangleBackground_MouseUp" MouseWheel="Canvas_MouseWheel">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}" Value="True">
                                <DataTrigger.Setters>
                                    <Setter Property="ItemsSource" Value="{Binding Source={StaticResource AllObjectsGMS1}, Mode=OneTime}"/>
                                </DataTrigger.Setters>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}" Value="False">
                                <DataTrigger.Setters>
                                    <Setter Property="ItemsSource" Value="{Binding Layers, Mode=OneWay}"/>
                                    <Setter Property="ItemContainerStyle">
                                        <Setter.Value>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Visibility" Value="{Binding IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                                                <Setter Property="Canvas.ZIndex">
                                                    <Setter.Value>
                                                        <MultiBinding Converter="{StaticResource LayerZIndexConverter}">
                                                            <Binding Mode="OneTime"/>
                                                            <!-- for notification only -->
                                                            <Binding Path="LayerDepth" Mode="OneWay"/>
                                                            <Binding Path="ParentRoom.Layers" Mode="OneWay"/>
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger.Setters>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:RoomCanvas x:Name="RoomCanvas" Width="{Binding Width, Mode=OneWay}" Height="{Binding Height, Mode=OneWay}" IsItemsHost="True" AllowDrop="True"
                                          DragOver="Canvas_DragOver" Drop="Canvas_Drop">
                            <Canvas.OpacityMask>
                                <DrawingBrush TileMode="Tile" ViewportUnits="Absolute">
                                    <DrawingBrush.Viewport>
                                        <MultiBinding Converter="{StaticResource GridConverter}">
                                            <Binding Path="GridWidth" Mode="OneWay"/>
                                            <Binding Path="GridHeight" Mode="OneWay"/>
                                        </MultiBinding>
                                    </DrawingBrush.Viewport>
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing>
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry>
                                                    <RectangleGeometry.Rect>
                                                        <MultiBinding Converter="{StaticResource GridConverter}">
                                                            <Binding Path="GridWidth" Mode="OneWay"/>
                                                            <Binding Path="GridHeight" Mode="OneWay"/>
                                                        </MultiBinding>
                                                    </RectangleGeometry.Rect>
                                                </RectangleGeometry>
                                            </GeometryDrawing.Geometry>
                                            <GeometryDrawing.Brush>
                                                <SolidColorBrush Color="Black"></SolidColorBrush>
                                            </GeometryDrawing.Brush>
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="Transparent" Thickness="{Binding GridThicknessPx, Mode=OneWay}"/>
                                            </GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Canvas.OpacityMask>
                            <Canvas.Background>
                                <DrawingBrush TileMode="Tile" ViewportUnits="Absolute">
                                    <DrawingBrush.Viewport>
                                        <MultiBinding Converter="{StaticResource GridConverter}">
                                            <Binding Path="GridWidth" Mode="OneWay"/>
                                            <Binding Path="GridHeight" Mode="OneWay"/>
                                        </MultiBinding>
                                    </DrawingBrush.Viewport>
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing>
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry>
                                                    <RectangleGeometry.Rect>
                                                        <MultiBinding Converter="{StaticResource GridConverter}">
                                                            <Binding Path="GridWidth" Mode="OneWay"/>
                                                            <Binding Path="GridHeight" Mode="OneWay"/>
                                                        </MultiBinding>
                                                    </RectangleGeometry.Rect>
                                                </RectangleGeometry>
                                            </GeometryDrawing.Geometry>
                                            <GeometryDrawing.Brush>
                                                <!-- this binding replaces itself with proper one -->
                                                <MultiBinding Mode="OneTime" Converter="{StaticResource BGColorConverter}">
                                                    <Binding Path="." RelativeSource="{RelativeSource Self}" Mode="OneTime"/>
                                                    <Binding Path="Flags" Mode="OneTime"/>
                                                </MultiBinding>
                                            </GeometryDrawing.Brush>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Canvas.Background>
                        </local:RoomCanvas>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Resources>
                    <Style x:Key="NearestNeighbor">
                        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
                        <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
                    </Style>

                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Layer}">
                        <ItemsControl ItemsSource="{Binding ., Mode=OneWay, Converter={StaticResource LayerItemsSourceConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:LayerCanvas Initialized="LayerCanvas_Initialized" Unloaded="LayerCanvas_Unloaded" DataContextChanged="LayerCanvas_DataContextChanged"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <!-- Offset doesn't work for instances layer; BG layer has its own translate transform -->
                                        <DataTrigger Binding="{Binding LayerType, Mode=OneTime, Converter={StaticResource LayerTypeConverter}, ConverterParameter=Canvas}" Value="Visible">
                                            <Setter Property="ItemContainerStyle">
                                                <Setter.Value>
                                                    <Style TargetType="ContentPresenter">
                                                        <!-- TODO: get rid of "Cannot find source for binding with reference 'RelativeSource FindAncestor..." error on layer rearrange -->
                                                        <Setter Property="Canvas.Left" Value="{Binding DataContext.XOffset, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Canvas}}"/>
                                                        <Setter Property="Canvas.Top" Value="{Binding DataContext.YOffset, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Canvas}}" />
                                                    </Style>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Background}">
                        <Rectangle Width="{Binding BackgroundDefinition.Texture.SourceWidth, Mode=OneWay}" Height="{Binding BackgroundDefinition.Texture.SourceHeight, Mode=OneWay}"
                                   MouseDown="Rectangle_MouseDown"
                                   Visibility="{Binding Enabled, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <!-- Giving names to transform elements prevents random "Cannot find governing FrameworkElement or FrameworkContentElement for target element." errors -->
                                    <TranslateTransform x:Name="transform0_0" X="{Binding XOffset, Mode=OneWay}" Y="{Binding YOffset, Mode=OneWay}"/>
                                    <ScaleTransform x:Name="transform0_1" ScaleX="{Binding CalcScaleX, Mode=OneWay}" ScaleY="{Binding CalcScaleY, Mode=OneWay}" CenterX="0" CenterY="0"/>
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                            <Rectangle.Style>
                                <Style BasedOn="{StaticResource NearestNeighbor}"/>
                            </Rectangle.Style>
                            <Rectangle.Fill>
                                <ImageBrush
                                    ImageSource="{Binding BackgroundDefinition.Texture, Mode=OneWay, Converter={StaticResource UndertaleCachedImageLoader}}"
                                    ViewportUnits="Absolute"
                                    AlignmentX="Left" AlignmentY="Top"
                                    TileMode="None"
                                    Stretch="None">
                                    <ImageBrush.Viewport>
                                        <MultiBinding Converter="{StaticResource BGViewportConverter}">
                                            <Binding RelativeSource="{RelativeSource AncestorType=Rectangle}" Mode="OneTime"/>
                                            <Binding Path="TiledVertically" Mode="OneWay"/>
                                            <Binding Path="TiledHorizontally" Mode="OneWay"/>
                                            <Binding Path="Stretch" Mode="OneWay"/>
                                            <!-- for notification only -->
                                            <Binding RelativeSource="{RelativeSource Self}" Path="ImageSource" Mode="OneWay"/>
                                            <Binding Path="XOffset" Mode="OneWay"/>
                                            <Binding Path="YOffset" Mode="OneWay"/>
                                        </MultiBinding>
                                    </ImageBrush.Viewport>
                                </ImageBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+GameObject}">
                        <Rectangle Width="{Binding Fill.ImageSource.Width, RelativeSource={RelativeSource Self}, Mode=OneWay}" Height="{Binding Fill.ImageSource.Height, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                   MouseDown="Rectangle_MouseDown" MouseMove="Rectangle_MouseMove" MouseUp="Rectangle_MouseUp"
                                   Opacity="{Binding Color, Mode=OneWay, Converter={StaticResource ColorToOpacityConverter}}">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle" BasedOn="{StaticResource NearestNeighbor}"/>
                            </Rectangle.Style>
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="transform1_0" ScaleX="{Binding ScaleX, Mode=OneWay}" ScaleY="{Binding ScaleY, Mode=OneWay}"
                                                    CenterX="{Binding SpriteXOffset, Converter={StaticResource NegateNumberConverter}, Mode=OneWay}"
                                                    CenterY="{Binding SpriteYOffset, Converter={StaticResource NegateNumberConverter}, Mode=OneWay}"/>
                                    <RotateTransform x:Name="transform1_1" Angle="{Binding OppositeRotation, Mode=OneWay}"
                                                     CenterX="{Binding SpriteXOffset, Converter={StaticResource NegateNumberConverter}, Mode=OneWay}"
                                                     CenterY="{Binding SpriteYOffset, Converter={StaticResource NegateNumberConverter}, Mode=OneWay}"/>
                                    <TranslateTransform x:Name="transform1_2" X="{Binding XOffset, Mode=OneWay}" Y="{Binding YOffset, Mode=OneWay}"/>
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                            <Rectangle.Fill>
                                <ImageBrush
                                    TileMode="None"
                                    Stretch="UniformToFill">
                                    <ImageBrush.ImageSource>
                                        <MultiBinding Converter="{StaticResource CachedImageLoaderWithIndex}">
                                            <Binding Path="ObjectDefinition.Sprite.Textures" Mode="OneWay"/>
                                            <Binding Path="WrappedImageIndex" Mode="OneWay"/>
                                        </MultiBinding>
                                    </ImageBrush.ImageSource>
                                </ImageBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Tile}">
                        <Rectangle Width="{Binding Width, Mode=OneWay}" Height="{Binding Height, Mode=OneWay}"
                                   MouseDown="Rectangle_MouseDown" MouseMove="Rectangle_MouseMove" MouseUp="Rectangle_MouseUp"
                                   Opacity="{Binding Color, Mode=OneWay, Converter={StaticResource ColorToOpacityConverter}}">
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="transform2_0" X="{Binding X, Mode=OneWay}" Y="{Binding Y, Mode=OneWay}"/>
                                    <ScaleTransform ScaleX="{Binding ScaleX, Mode=OneWay}" ScaleY="{Binding ScaleY, Mode=OneWay}"
                                                    CenterX="{Binding X, Mode=OneWay}" CenterY="{Binding Y, Mode=OneWay}"/>
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                            <Rectangle.Style>
                                <Style BasedOn="{StaticResource NearestNeighbor}"/>
                            </Rectangle.Style>
                            <Rectangle.Fill>
                                <ImageBrush
                                    TileMode="None"
                                    Stretch="UniformToFill">
                                    <ImageBrush.ImageSource>
                                        <MultiBinding Converter="{StaticResource CachedTileImageLoader}">
                                            <Binding Mode="OneTime"/>
                                            <Binding Path="Width" Mode="OneWay"/>
                                            <Binding Path="Height" Mode="OneWay"/>
                                            <!-- for notification only -->
                                            <Binding Path="Tpag" Mode="OneWay"/>
                                            <Binding Path="SourceX" Mode="OneWay"/>
                                            <Binding Path="SourceY" Mode="OneWay"/>
                                        </MultiBinding>
                                    </ImageBrush.ImageSource>
                                </ImageBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+SpriteInstance}">
                        <Rectangle Width="{Binding Fill.ImageSource.Width, RelativeSource={RelativeSource Self}, Mode=OneWay}" Height="{Binding Fill.ImageSource.Height, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                   MouseDown="Rectangle_MouseDown" MouseMove="Rectangle_MouseMove" MouseUp="Rectangle_MouseUp"
                                   Opacity="{Binding Color, Mode=OneWay, Converter={StaticResource ColorToOpacityConverter}}">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle" BasedOn="{StaticResource NearestNeighbor}"/>
                            </Rectangle.Style>
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="transform4_0" ScaleX="{Binding ScaleX, Mode=OneWay}" ScaleY="{Binding ScaleY, Mode=OneWay}"
                                                    CenterX="{Binding SpriteXOffset, Converter={StaticResource NegateNumberConverter}, Mode=OneWay}"
                                                    CenterY="{Binding SpriteYOffset, Converter={StaticResource NegateNumberConverter}, Mode=OneWay}"/>
                                    <RotateTransform x:Name="transform4_1" Angle="{Binding OppositeRotation, Mode=OneWay}"
                                                     CenterX="{Binding SpriteXOffset, Converter={StaticResource NegateNumberConverter}, Mode=OneWay}"
                                                     CenterY="{Binding SpriteYOffset, Converter={StaticResource NegateNumberConverter}, Mode=OneWay}"/>
                                    <TranslateTransform x:Name="transform4_2" X="{Binding XOffset, Mode=OneWay}" Y="{Binding YOffset, Mode=OneWay}"/>
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                            <Rectangle.Fill>
                                <ImageBrush
                                    TileMode="None"
                                    Stretch="UniformToFill">
                                    <ImageBrush.ImageSource>
                                        <MultiBinding Converter="{StaticResource CachedImageLoaderWithIndex}">
                                            <Binding Path="Sprite.Textures" Mode="OneWay"/>
                                            <Binding Path="WrappedFrameIndex" Mode="OneWay"/>
                                        </MultiBinding>
                                    </ImageBrush.ImageSource>
                                </ImageBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+ParticleSystemInstance}">
                        <Canvas Background="Transparent"
                                Opacity="{Binding Color, Mode=OneWay, Converter={StaticResource ColorToOpacityConverter}}"
                                MouseDown="Rectangle_MouseDown" MouseMove="Rectangle_MouseMove" MouseUp="Rectangle_MouseUp">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform X="-8" Y="-8"/>
                                    <TranslateTransform x:Name="transform6_0" X="{Binding X, Mode=OneWay}" Y="{Binding Y, Mode=OneWay}"/>
                                    <ScaleTransform x:Name="transform6_1" ScaleX="{Binding ScaleX, Mode=OneWay}" ScaleY="{Binding ScaleY, Mode=OneWay}"/>
                                    <RotateTransform x:Name="transform6_2" Angle="{Binding OppositeRotation, Mode=OneWay}"
                                                     CenterX="{Binding X, Mode=OneWay}" CenterY="{Binding Y, Mode=OneWay}"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                            <Ellipse Width="16" Height="16" Fill="Silver"/>

                            <Ellipse Canvas.Left="5" Canvas.Top="5" Width="3" Height="3" Fill="White"/>
                            <Line Canvas.Left="3.5" Canvas.Top="6.5" X2="6" Stroke="White"/>
                            <Line Canvas.Left="6.5" Canvas.Top="3.5" Y2="6" Stroke="White"/>

                            <Ellipse Canvas.Left="9" Canvas.Top="9" Width="2" Height="2" Fill="White"/>
                            <Line Canvas.Left="8" Canvas.Top="10" X2="4" Stroke="White"/>
                            <Line Canvas.Left="10" Canvas.Top="8" Y2="4" Stroke="White"/>

                            <Border BorderBrush="DarkCyan" BorderThickness="1" Background="Transparent"
                                    Width="{Binding ParticleSystem, Mode=OneWay, Converter={StaticResource ParticleSystemRectConverter}, ConverterParameter=width}"
                                    Height="{Binding ParticleSystem, Mode=OneWay, Converter={StaticResource ParticleSystemRectConverter}, ConverterParameter=height}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="transform6_3"
                                                        X="{Binding ParticleSystem, Mode=OneWay, Converter={StaticResource ParticleSystemRectConverter}, ConverterParameter=x}"
                                                        Y="{Binding ParticleSystem, Mode=OneWay, Converter={StaticResource ParticleSystemRectConverter}, ConverterParameter=y}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Canvas>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Layer+LayerBackgroundData}">
                        <Rectangle Width="{Binding Sprite.Textures[0].Texture.SourceWidth, Mode=OneWay}" Height="{Binding Sprite.Textures[0].Texture.SourceHeight, Mode=OneWay}"
                                   MouseDown="Rectangle_MouseDown"
                                   Opacity="{Binding Color, Mode=OneWay, Converter={StaticResource ColorToOpacityConverter}}"
                                   Visibility="{Binding Visible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="transform3_0" ScaleX="{Binding CalcScaleX, Mode=OneWay}" ScaleY="{Binding CalcScaleY, Mode=OneWay}" CenterX="0" CenterY="0"/>
                                    <TranslateTransform x:Name="transform3_1" X="{Binding XOffset, Mode=OneWay}" Y="{Binding YOffset, Mode=OneWay}"/>
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                            <Rectangle.Style>
                                <Style BasedOn="{StaticResource NearestNeighbor}"/>
                            </Rectangle.Style>
                            <Rectangle.Fill>
                                <ImageBrush
                                    ImageSource="{Binding Sprite.Textures[0].Texture, Mode=OneWay, Converter={StaticResource UndertaleCachedImageLoader}}"
                                    ViewportUnits="Absolute"
                                    AlignmentX="Left" AlignmentY="Top"
                                    TileMode="None"
                                    Stretch="None">
                                    <ImageBrush.Viewport>
                                        <MultiBinding Converter="{StaticResource BGViewportConverter}">
                                            <Binding RelativeSource="{RelativeSource AncestorType=Rectangle}" Mode="OneTime"/>
                                            <Binding Path="TiledVertically" Mode="OneWay"/>
                                            <Binding Path="TiledHorizontally" Mode="OneWay"/>
                                            <Binding Path="Stretch" Mode="OneWay"/>
                                            <!-- for notification only -->
                                            <Binding Path="ParentLayer.XOffset" Mode="OneWay"/>
                                            <Binding Path="ParentLayer.YOffset" Mode="OneWay"/>
                                            <Binding Path="ParentLayer.ParentRoom.Width" Mode="OneWay"/>
                                            <Binding Path="ParentLayer.ParentRoom.Height" Mode="OneWay"/>
                                            <Binding RelativeSource="{RelativeSource Self}" Path="ImageSource" Mode="OneWay"/>
                                        </MultiBinding>
                                    </ImageBrush.Viewport>
                                </ImageBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Layer+LayerTilesData}">
                        <ContentControl Content="{Binding ., Mode=OneWay}" ContentTemplateSelector="{StaticResource TileLayerTemplateSelector}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:UndertalePathEditor+LineData}">
                        <Line X1="{Binding From.X, Mode=OneWay}" Y1="{Binding From.Y, Mode=OneWay}" X2="{Binding To.X, Mode=OneWay}" Y2="{Binding To.Y, Mode=OneWay}" Stroke="Green" StrokeThickness="2"/>
                    </DataTemplate>

                    <DataTemplate x:Key="TileLayerImageTemplate">
                        <local:TileLayerImage
                            LayerTilesData="{Binding ., Mode=OneWay}"
                            Width="{Binding ParentLayer.ParentRoom.Width, Mode=OneWay}" Height="{Binding ParentLayer.ParentRoom.Height, Mode=OneWay}"
                            Stretch="None"
                            MouseDown="Rectangle_MouseDown">
                            <Image.Style>
                                <Style BasedOn="{StaticResource NearestNeighbor}"/>
                            </Image.Style>
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource CachedTileDataLoader}">
                                    <Binding Mode="OneTime"/>
                                    <Binding Path="TileData" Mode="OneWay"/>
                                </MultiBinding>
                            </Image.Source>
                        </local:TileLayerImage>
                    </DataTemplate>
                    <DataTemplate x:Key="TileLayerRectanglesTemplate">
                        <ItemsControl>
                            <ItemsControl.ItemsSource>
                                <MultiBinding Converter="{StaticResource TileRectanglesConverter}">
                                    <Binding Mode="OneWay"/>
                                    <Binding Path="TileData" Mode="OneWay"/>
                                </MultiBinding>
                            </ItemsControl.ItemsSource>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas
                                        Width="{Binding ParentLayer.ParentRoom.Width, Mode=OneWay}" Height="{Binding ParentLayer.ParentRoom.Height, Mode=OneWay}"
                                        MouseDown="Rectangle_MouseDown"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type local:TileRectangle}">
                                    <Rectangle Width="{Binding Width, Mode=OneTime}" Height="{Binding Height, Mode=OneTime}"
                                               RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle" BasedOn="{StaticResource NearestNeighbor}"/>
                                        </Rectangle.Style>
                                        <Rectangle.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="transform5_0" ScaleX="{Binding ScaleX, Mode=OneTime}" ScaleY="{Binding ScaleY, Mode=OneTime}"/>
                                                <RotateTransform x:Name="transform5_1" Angle="{Binding Angle, Mode=OneTime}"/>
                                                <TranslateTransform x:Name="transform5_2" X="{Binding X, Mode=OneTime}" Y="{Binding Y, Mode=OneTime}"/>
                                            </TransformGroup>
                                        </Rectangle.RenderTransform>
                                        <Rectangle.Fill>
                                            <ImageBrush
                                                x:Name="TileImageSource"
                                                ImageSource="{Binding ImageSrc, Mode=OneTime}"
                                                TileMode="None"
                                                Stretch="UniformToFill">
                                            </ImageBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </ScrollViewer>
        <local:ButtonDark Grid.Column="0" Grid.Row="3" Content="另存为 PNG" Click="ExportAsPNG_Click"/>
    </Grid>
</local:DataUserControl>
