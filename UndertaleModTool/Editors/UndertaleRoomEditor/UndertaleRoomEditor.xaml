                            <local:TextBoxDark Grid.Row="5" Grid.Column="2" Margin="3" Text="{Binding TileDepth}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Margin="3">实例 ID</TextBlock>
                            <local:TextBoxDark Grid.Row="6" Grid.Column="2" Margin="3" Text="{Binding InstanceID}"/>

