                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="TextBox" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="local:UndertaleObjectReference" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="local:ColorPicker" BasedOn="{StaticResource Centered}"/>
                            </Grid.Resources>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3">位置</TextBlock>
                            <Grid Grid.Row="0" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:TextBoxDark Grid.Column="0" Margin="3" Text="{Binding X}" ToolTip="X"/>
                                <local:TextBoxDark Grid.Column="1" Margin="3" Text="{Binding Y}" ToolTip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3">定义</TextBlock>
                            <local:UndertaleObjectReference Grid.Row="1" Grid.Column="2" Margin="3" ObjectReference="{Binding ObjectDefinition}" CanRemove="False">
                                <local:UndertaleObjectReference.Style>
                                    <Style TargetType="{x:Type local:UndertaleObjectReference}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsGMS2, Mode=OneTime, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}}" Value="Visible">
                                                <DataTrigger.Setters>
                                                    <Setter Property="ObjectType" Value="{x:Type undertale:UndertaleSprite}"/>
                                                </DataTrigger.Setters>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.IsGMS2, Mode=OneTime, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}}" Value="Collapsed">
                                                <DataTrigger.Setters>
                                                    <Setter Property="ObjectType" Value="{x:Type undertale:UndertaleBackground}"/>
                                                </DataTrigger.Setters>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </local:UndertaleObjectReference.Style>
                            </local:UndertaleObjectReference>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="3">来源</TextBlock>
                            <Grid Grid.Row="2" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:TextBoxDark Grid.Column="0" Margin="3" Text="{Binding SourceX}" ToolTip="X"/>
                                <local:TextBoxDark Grid.Column="1" Margin="3" Text="{Binding SourceY}" ToolTip="Y"/>
                                <local:TextBoxDark Grid.Column="2" Margin="3" Text="{Binding Width}" ToolTip="宽度"/>
                                <local:TextBoxDark Grid.Column="3" Margin="3" Text="{Binding Height}" ToolTip="高度"/>
                            </Grid>

                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="3" HorizontalAlignment="Center" Foreground="DarkGray" FontStyle="Italic" TextWrapping="Wrap">
                                提示：点击图块即可选中它。<LineBreak/>
                                按住 ALT 可选择一个图块<Run FontWeight="DemiBold" Foreground="#FFB23131">区域</Run>。
