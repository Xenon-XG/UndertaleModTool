                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Layer}">
                        <Grid IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition>
                                    <ColumnDefinition.Width>
                                        <MultiBinding Mode="OneWay" Converter="{StaticResource GridColumnSizeConverter}">
                                            <Binding Mode="OneTime" ElementName="LayerDataContent"/>
                                            <Binding Mode="OneWay" Path="Content" ElementName="LayerDataContent"/>
                                        </MultiBinding>
                                    </ColumnDefinition.Width>
                                </ColumnDefinition>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="{Binding LayerType, Mode=OneTime, Converter={StaticResource GridSizeGroupConverter}}"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="{Binding LayerType, Mode=OneTime, Converter={StaticResource GridSizeGroupConverter}}"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="s22"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="TextBox" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource Centered}"/>
                                <Style TargetType="local:UndertaleStringReference" BasedOn="{StaticResource Centered}"/>
                            </Grid.Resources>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3">图层名称</TextBlock>
                            <local:UndertaleStringReference Grid.Row="0" Grid.Column="2" Margin="3" ObjectReference="{Binding LayerName}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3">图层 ID</TextBlock>
                            <local:TextBoxDark Grid.Row="1" Grid.Column="2" Margin="3" Text="{Binding LayerId}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="3">图层类型</TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="3" Text="{Binding LayerType}" FontWeight="Bold"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="3">深度</TextBlock>
                            <local:TextBoxDark Grid.Row="3" Grid.Column="2" Margin="3" Text="{Binding LayerDepth}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="3" Visibility="{Binding LayerType, Mode=OneTime, Converter={StaticResource LayerTypeConverter}}">偏移</TextBlock>
                            <Grid Grid.Row="4" Grid.Column="2" Visibility="{Binding LayerType, Mode=OneTime, Converter={StaticResource LayerTypeConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:TextBoxDark Grid.Column="0" Margin="3" Text="{Binding XOffset}" ToolTip="X"/>
                                <local:TextBoxDark Grid.Column="1" Margin="3" Text="{Binding YOffset}" ToolTip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="3" Visibility="{Binding LayerType, Mode=OneTime, Converter={StaticResource LayerTypeConverter}}">速度</TextBlock>
                            <Grid Grid.Row="5" Grid.Column="2" Visibility="{Binding LayerType, Mode=OneTime, Converter={StaticResource LayerTypeConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:TextBoxDark Grid.Column="0" Margin="3" Text="{Binding HSpeed}" ToolTip="水平"/>
                                <local:TextBoxDark Grid.Column="1" Margin="3" Text="{Binding VSpeed}" ToolTip="垂直"/>
                            </Grid>

                            <TextBlock Grid.Row="6" Grid.Column="0" Margin="3">可见</TextBlock>
                            <CheckBox Grid.Row="6" Grid.Column="2" Margin="3" IsChecked="{Binding IsVisible}"/>

                            <Separator Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"/>

                            <ContentControl Name="LayerDataContent" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3">
                                <ContentControl.Content>
                                    <Binding Path="Data" Mode="OneTime">
                                        <Binding.TargetNullValue>
                                            <TextBlock Margin="3" Text="图层数据为空。"/>
                                        </Binding.TargetNullValue>
                                    </Binding>
                                </ContentControl.Content>
                                <ContentControl.Resources>
                                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Layer+LayerInstancesData}">
                                        <TextBlock Margin="3" Text="包含游戏对象实例，已列于左侧树中"/>
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Layer+LayerTilesData}">
                                        <Grid IsSharedSizeScope="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="*"/>
